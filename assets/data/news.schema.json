{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4x.ntpu.edu.tw/assets/data/news.schema.json",
  "title": "AI4X News & Events data",
  "type": "object",
  "required": ["items"],
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/newsItem" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "newsItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "summary",
        "category",
        "source_type",
        "publish_date",
        "featured",
        "priority"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "content": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "category": {
          "type": "string",
          "enum": ["announcement", "academic", "competition", "collaboration", "resource"]
        },
        "category_label": { "type": "string" },
        "source_type": { "type": "string", "enum": ["internal", "external"] },
        "publish_date": { "$ref": "#/$defs/date" },
        "event_date": { "$ref": "#/$defs/date" },
        "deadline": { "$ref": "#/$defs/date" },
        "location": { "type": "string" },
        "eligibility": { "type": "string" },
        "organizers": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "external_url": { "type": "string", "pattern": "^https?://" },
        "source_name": { "type": "string" },
        "featured": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "source_type": { "const": "external" } } },
          "then": { "required": ["external_url", "source_name"] }
        }
      ]
    }
  }
}
